"use client";

import React from "react";
import { useDeleteProduct, useProducts } from "../../hooks/products/useproduct";

export default function ProductsPage() {
  const { data: productsList, isLoading, isError, error } = useProducts();
  const deleteMutation = useDeleteProduct();

  if (isLoading) return <div className="p-8 text-center text-slate-500 animate-pulse">Loading inventory...</div>;
  if (isError) return <div className="p-8 text-rose-600">Error: {(error as Error).message}</div>;

  return (
    <div className="p-8 max-w-7xl mx-auto">
      
      {/* 1. HEADER SECTION */}
      <div className="flex justify-between items-center mb-8">
        <h1 className="text-2xl font-bold text-slate-900">Products Inventory</h1>
        <button className="bg-indigo-600 hover:bg-indigo-700 text-white text-sm px-4 py-2.5 rounded-lg shadow-sm">
          Add Product
        </button>
      </div>

      {/* 2. THE PRODUCTS CONTAINER */}
      <div className="space-y-4"> 
        {productsList?.data?.map((product: any) => (
          <div 
            key={product.id} 
            className="flex items-center justify-between bg-white border border-slate-200 rounded-xl p-5 shadow-sm hover:bg-slate-50/70 transition-colors"
          >
            {/* Left side: Product Name & SKU */}
            <div className="space-y-1">
              <div className="font-semibold text-slate-900 text-base">{product.name}</div>
              <div className="font-mono text-xs text-slate-400">SKU: {product.sku || "—"}</div>
            </div>

            {/* Right side: Stock badge and Delete Button */}
            <div className="flex items-center space-x-6">
              <span className="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                {product.quantity} units
              </span>

              <button
                onClick={() => {
                  if (confirm(`Permanently remove "${product.name}"?`)) {
                    deleteMutation.mutate(product.id);
                  }
                }}
                disabled={deleteMutation.isPending}
                className="text-xs font-semibold text-rose-600 hover:text-rose-800 disabled:opacity-40"
              >
                {deleteMutation.isPending ? "Removing..." : "Delete"}
              </button>
            </div>

          </div>
        ))}
      </div>

    </div>
  );
}
